generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  phone         String
  role          String   @default("EMPLOYEE") // BOSS, EMPLOYEE, THIRD_PARTY
  password      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignedTasks Task[]   @relation("AssignedTasks")
  createdTasks  Task[]   @relation("CreatedTasks")
}

model Task {
  id           String     @id @default(uuid())
  title        String
  description  String?
  location     String?
  startTime    DateTime
  endTime      DateTime
  status       String     @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  isPersonal   Boolean    @default(false)
  
  assignedToId String
  assignedTo   User       @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: Cascade)

  createdById  String
  createdBy    User       @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  
  whatsappLogs WhatsAppLog[]
}

model WhatsAppLog {
  id             String   @id @default(uuid())
  taskId         String?
  task           Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  recipientPhone String
  recipientName  String
  message        String
  status         String   @default("SIMULATED") // SIMULATED, SENT, FAILED
  sentAt         DateTime @default(now())
}
